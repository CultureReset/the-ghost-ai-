{
  "app_version": "4.12.0",
  "start": "profile",
  "screens": {
    "profile": [
      { "id": "com.google.android.apps.business:id/profile_header", "text": "Dolphin Cruises" },
      { "text": "Business hours", "goto": "hours" }
    ],
    "hours": [
      { "desc": "fri", "goto": "edit" },
      { "desc": "sat", "goto": "edit" }
    ],
    "edit": [
      { "id": "com.google.android.apps.business:id/open_time",  "text": "10:00" },
      { "id": "com.google.android.apps.business:id/close_time", "text": "16:00" },
      { "text": "Save", "goto": "saved" }
    ],
    "saved": [
      { "text": "Updated", "id": "toast" },
      { "id": "com.google.android.apps.business:id/profile_header", "text": "Dolphin Cruises" }
    ]
  }
}
